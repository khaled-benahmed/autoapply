POSTGRES_PASSWORD=replace-with-a-local-password
MINIO_ROOT_USER=replace-with-a-local-user
MINIO_ROOT_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://autoapply:replace-with-a-local-password@postgres:5432/autoapply
# Ordered g4f provider cascade, each entry as Provider:Model.
# Treated in sequence until one returns valid extraction JSON.
G4F_PROVIDER_POOL=Gemini:gemini-3.6-flash,Cloudflare:glm-5.2,Gemini:gemini-3.1-flash-lite,LLM7:default
G4F_MAX_TOKENS=8000
G4F_CHUNK_CHARACTERS=8000
